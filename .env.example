# ==============================================================================
# Edge Vision Monitor - Environment Variable Configuration Template
# Copy to .env to apply custom overrides
# ==============================================================================

# Server Network & Security
EVM_SERVER__HOST=127.0.0.1
EVM_SERVER__PORT=8000
EVM_SERVER__LOG_LEVEL=INFO
EVM_SERVER__PREVIEW_MAX_FPS=15
EVM_SERVER__PREVIEW_QUALITY=75

# Hailo Model & Inference Parameters
EVM_MODEL__HEF_PATH=models/yolo11n.hef
EVM_MODEL__LABELS_PATH=models/labels.txt
EVM_MODEL__CONFIDENCE_THRESHOLD=0.25
EVM_MODEL__NMS_IOU_THRESHOLD=0.45
EVM_MODEL__MAX_DETECTIONS=100

# Video Source Configuration
EVM_VIDEO__DEFAULT_SOURCE_TYPE=file
EVM_VIDEO__USB_DEVICE_PATH=/dev/video0
EVM_VIDEO__VIDEO_FILE_PATH=media/sample.mp4
EVM_VIDEO__CAPTURE_WIDTH=640
EVM_VIDEO__CAPTURE_HEIGHT=480
EVM_VIDEO__CAPTURE_FPS=30

# Telemetry Intervals
EVM_TELEMETRY__SYSTEM_INTERVAL_SECONDS=1.0
EVM_TELEMETRY__HAILO_INTERVAL_SECONDS=0.5

# SQLite Storage & Retention
EVM_STORAGE__DB_PATH=data/telemetry.db
EVM_STORAGE__RETENTION_DAYS=7

# Remote Edge Host & SSH Deployment Defaults
EVM_REMOTE_HOST=10.199.153.118
EVM_REMOTE_USER=iotgwai
